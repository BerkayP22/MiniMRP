@model MiniMRP.Web.Models.OrderCreateViewModel

<h1>Yeni Sipariş</h1>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="No" class="form-label">Sipariş No</label>
        <input asp-for="No" class="form-control" />
        <span asp-validation-for="No" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="PositionNo" class="form-label">Poz No</label>
        <input asp-for="PositionNo" class="form-control" />
        <span asp-validation-for="PositionNo" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="Quantity" class="form-label">Adet</label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ProductId" class="form-label">Ürün</label>
        <select asp-for="ProductId" asp-items="ViewBag.Products" class="form-select">
            <option value="0">-- Ürün seçin --</option>
        </select>
        <span asp-validation-for="ProductId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>