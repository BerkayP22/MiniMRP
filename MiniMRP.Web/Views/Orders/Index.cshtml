@model List<MiniMRP.Core.Entities.Order>
<table class="table">
    <thead>
        <tr>
            <th>Order No</th>
            <th>Position No</th>
            <th>Product</th>
            <th>Quantity</th>
            
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.No</td>
                <td>@order.PositionNo</td>
                <td>@order.Product.Name</td>
                <td>@order.Quantity</td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-primary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>

